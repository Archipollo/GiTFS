{
  "name": "gitfs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Git-like diff, timeline, and scenario tool for GTFS public transit feeds",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@zip.js/zip.js": "^2.8.26",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250422.0",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.9",
    "wrangler": "^4.0.0"
  }
}
